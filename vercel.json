{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/css/:path*",     "destination": "/web/css/:path*" },
    { "source": "/js/:path*",      "destination": "/web/js/:path*" },
    { "source": "/fonts/:path*",   "destination": "/web/fonts/:path*" },
    { "source": "/manager/:path*", "destination": "/web/manager/:path*" },
    { "source": "/",               "destination": "/web/index.html" }
  ]
}
